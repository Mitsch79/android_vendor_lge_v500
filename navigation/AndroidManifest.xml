<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="org.lineageos.device.v500.navigation">
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.WRITE_SETTINGS" />
    <uses-permission android:name="lineageos.permission.WRITE_SETTINGS" />
    <queries>
        <provider android:authorities="lineagesettings" />
    </queries>
    <application android:allowBackup="false" android:directBootAware="true"
        android:label="V500 navigation defaults">
        <receiver android:name=".NavigationDefaults" android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.LOCKED_BOOT_COMPLETED" />
                <action android:name="android.intent.action.BOOT_COMPLETED" />
            </intent-filter>
        </receiver>
    </application>
</manifest>
